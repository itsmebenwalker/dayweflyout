# Supabase — copy from Settings → API in your Supabase project dashboard
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# fli microservice — use http://localhost:8001 for local dev
# On Railway: set to the internal service URL after deploying fli-service
FLI_SERVICE_URL=http://localhost:8001

# Affiliate IDs — leave blank until approved; booking links still work without them
NEXT_PUBLIC_SKYSCANNER_ID=
NEXT_PUBLIC_BOOKING_AID=
